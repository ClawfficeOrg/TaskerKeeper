{
  "name": "paseo-tidetable",
  "version": "0.1.0",
  "description": "Tidetable sidebar and workspace panel for Paseo, driven by `tidetable sidebar --json`.",
  "license": "MIT",
  "main": "server.js",
  "files": [
    "server.js",
    "client.js",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "check": "node --check server.js && node --check client.js"
  },
  "paseo": {
    "displayName": "Tidetable",
    "description": "Read-only Tidetable sidebar: current, concurrent, upcoming, phase tree, overall tree.",
    "client": "./client.js",
    "server": "./server.js",
    "settings": {
      "todo": {
        "type": "string",
        "description": "Path to the Tidetable todo file (falls back to TIDETABLE_TODO env).",
        "default": ""
      },
      "width": {
        "type": "number",
        "description": "Sidebar line-width budget passed as --width.",
        "default": 80
      },
      "height": {
        "type": "number",
        "description": "Sidebar line-height budget passed as --height.",
        "default": 40
      }
    }
  }
}
